SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite+aiosqlite:////app/data/observia.db
CORS_ORIGINS=["*"]
DEBUG=false

# Dynatrace response cache (TTL seconds) used during analyses
CACHE_DB_PATH=/app/data/.cache/observia-cache.db
CACHE_DEFAULT_TTL=300

# Authentication & RBAC (opt-in). When false the API is open (single-user/self-hosted).
AUTH_ENABLED=false
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=observia-admin

# Frontend (leave empty in production - nginx proxies /api/)
VITE_API_URL=
